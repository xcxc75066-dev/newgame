# Copy this file to .env on the server and fill in the real values.
# Never commit .env to GitHub.

# Telegram bot from @BotFather (revoke and regenerate if it was ever shared)
AMANI_TELEGRAM_BOT_TOKEN=
AMANI_TELEGRAM_CHAT_ID=

# Long random secret for the admin API (orders list / status updates)
AMANI_ADMIN_TOKEN=

# Set to 1 only when the site is behind Cloudflare
AMANI_BEHIND_CLOUDFLARE=0

# Comma-separated list, e.g. https://example.com,https://www.example.com
AMANI_ALLOWED_ORIGINS=
